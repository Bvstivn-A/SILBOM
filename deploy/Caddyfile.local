# SILBOM_TEST_HOST es la IP LAN del computador, sin protocolo ni puerto.
# Importar la CA pública de Caddy en los teléfonos de prueba. Ver docs/PRUEBAS_MOVILES.md.
{
	# Solo el puerto 8443: sin redirección en :80 (requeriría root).
	auto_https disable_redirects
	# No instalar la CA en el almacén del sistema del computador.
	skip_install_trust
}

https://{$SILBOM_TEST_HOST}:8443 {
	tls internal
	reverse_proxy 127.0.0.1:8080
}
